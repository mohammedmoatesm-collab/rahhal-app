{
  "name": "rahhal-app",
  "version": "0.1.0",
  "private": true,
  "description": "RAHHAL cross-platform app starter",
  "scripts": {
    "build": "echo 'Static web app: contents of www/ are ready to deploy'",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "android:build": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}